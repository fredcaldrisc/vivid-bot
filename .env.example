# Copy to .env (never commit the real one). Use long random values for tokens.

# --- Meta / WhatsApp Cloud API ---
VERIFY_TOKEN=replace-with-a-random-meta-verification-token
APP_SECRET=your-meta-app-secret
WHATSAPP_TOKEN=your-permanent-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
GRAPH_API_VERSION=v23.0
REQUIRE_SIGNATURE=true
# Approved Utility template with ONE body variable, "⏰ VIVID reminder: {{1}}",
# and ONE quick-reply button, "Open reminder".
REMINDER_TEMPLATE=vivid_reminder
REMINDER_TEMPLATE_LANG=en

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# --- Voice notes: speech-to-text (GhanaNLP Khaya, Twi + English). Optional. ---
# Without it, VIVID still saves and replays voice notes, but asks users to type the time.
ASR_URL=https://translation-api.ghananlp.org/asr/v1/transcribe?language={lang}
ASR_KEY=

# --- Subscriptions (Paystack) ---
PAYSTACK_SECRET_KEY=sk_test_...
SUBSCRIPTION_PRICE_PESEWAS=2000
SUBSCRIPTION_DAYS=30
PUBLIC_BASE_URL=https://your-domain.example

# --- SMS fallback (Arkesel) ---
ARKESEL_API_KEY=
# Must be approved in your Arkesel dashboard (max 11 characters).
SMS_SENDER_ID=VIVID
# SMS goes out if WhatsApp hasn't reached the phone this many minutes after the reminder time.
SMS_FALLBACK_MINUTES=5
# A reminder not marked Done this many minutes after it fired counts as Missed.
MISSED_AFTER_MINUTES=120

# --- App ---
ADMIN_TOKEN=replace-with-a-long-random-admin-token
VIVID_TIMEZONE=Africa/Accra
DATABASE_PATH=data/vivid.db
AUDIO_DIR=data/audio
RUN_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=20
